# Used by both apps in development (bun run dev loads this file).

# --- API (apps/api) ---
BETTER_AUTH_SECRET=... # at least 32 random characters: openssl rand -base64 32
# The URL you open in the browser (the web app, not the API)
BETTER_AUTH_URL=http://localhost:3000
# Optional, comma-separated extra origins allowed to call the auth endpoints
TRUSTED_ORIGINS=

# Initial admin user, created when the API starts and no admin exists
ADMIN_NAME=Steve
ADMIN_EMAIL=example@gmail.com
ADMIN_PASSWORD=password

# API_PORT=3001
# DATABASE_PATH=/absolute/path/database.sqlite   # default: <repo>/data/database.sqlite

# --- Web (apps/web) ---
# Where the web app's server and dev proxy reach the API
# API_URL=http://localhost:3001
# PORT=3000                              # production server (apps/web/server.ts)
