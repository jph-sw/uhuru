{
  "name": "uhuru",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "dev": "bun --filter @uhuru/api --filter @uhuru/web dev",
    "build": "bun --filter @uhuru/web build",
    "test": "bun --filter @uhuru/web test",
    "test:contract": "bun --filter @uhuru/contract-tests test",
    "db:generate": "bun --filter @uhuru/api db:generate",
    "db:migrate": "bun --filter @uhuru/api db:migrate",
    "db:push": "bun --filter @uhuru/api db:push",
    "db:pull": "bun --filter @uhuru/api db:pull",
    "db:studio": "bun --filter @uhuru/api db:studio",
    "openapi": "bun --filter @uhuru/api openapi && bun --filter @uhuru/openapi generate",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
