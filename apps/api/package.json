{
	"name": "@uhuru/api",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "bun --env-file=../../.env --watch src/index.ts",
		"start": "bun src/index.ts",
		"db:generate": "bun --env-file=../../.env --bun drizzle-kit generate",
		"db:migrate": "bun --env-file=../../.env --bun drizzle-kit migrate",
		"db:push": "bun --env-file=../../.env --bun drizzle-kit push",
		"db:pull": "bun --env-file=../../.env --bun drizzle-kit pull",
		"db:studio": "bun --env-file=../../.env --bun drizzle-kit studio",
		"typecheck": "tsc --noEmit",
		"openapi": "bun scripts/openapi.ts"
	},
	"dependencies": {
		"@faker-js/faker": "^10.3.0",
		"@libsql/client": "^0.17.0",
		"@sinclair/typebox": "^0.34.48",
		"better-auth": "^1.5.3",
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.45.1",
		"drizzle-typebox": "^0.3.3",
		"elysia": "^1.4.27",
		"ulidx": "^2.4.1"
	},
	"devDependencies": {
		"@elysiajs/openapi": "1.4.17",
		"bun-types": "^1.3.10",
		"dotenv": "^17.3.1",
		"tsx": "^4.21.0",
		"typescript": "^5.7.2"
	}
}
